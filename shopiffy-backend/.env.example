# Copy this file to .env and fill in your real values. Never commit the real .env file.

# Your MongoDB Atlas connection string (from Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/shopiffy?retryWrites=true&w=majority

# The port the API server runs on (Render/Railway set this automatically in production)
PORT=5000
